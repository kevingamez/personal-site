---
import type { HomeStrings } from "@/content/home"

interface Props {
  t: HomeStrings["stack"]
}

const { t } = Astro.props
---

<section id="stack">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="sec-num">{t.secNum}</div>
        <h2 class="sec-title"><Fragment set:html={t.titleHtml} /></h2>
      </div>
      <p class="sec-blurb">{t.blurb}</p>
    </div>
    <div class="stack-grid">
      {
        t.cols.map((col, i) => (
          <div class="stack-col">
            <div class="stack-num">0{i + 1}</div>
            <h3 class="stack-name">{col.name}</h3>
            <ul class="stack-list">
              {col.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
