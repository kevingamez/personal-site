---
import type { HomeStrings } from "@/content/home"
import { formatBogotaTime } from "@/scripts/clock"

interface Props {
  t: HomeStrings["hero"]
}

const { t } = Astro.props
---

<header class="hero">
  <div class="wrap hero-grid">
    <div class="hero-rail" aria-hidden="true">
      <span class="rail-text">{t.metaRole}</span>
      <span class="rail-line"></span>
      <span class="rail-year">2026</span>
    </div>
    <div class="hero-copy">
      <div class="hero-stats">
        <div class="stat">
          <div class="stat-num">[ {t.stat1Num} ]</div>
          <div class="stat-cap">{t.stat1Label}</div>
        </div>
        <div class="stat">
          <div class="stat-num">[ {t.stat2Num} ]</div>
          <div class="stat-cap">{t.stat2Label}</div>
        </div>
      </div>
      <h1 class="hero-title"><Fragment set:html={t.titleHtml} /></h1>
      <p class="hero-lede"><Fragment set:html={t.lede} /></p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#contact">{t.btnGetInTouch}</a>
        <a class="arrow-link" href="#about">{t.scrollDown} ↓</a>
      </div>
    </div>
    <div class="hero-media">
      <div class="media-frame">
        <picture>
          <source srcset="/kevin.webp" type="image/webp" />
          <img
            src="/kevin.jpg"
            alt={t.portraitAlt}
            width="640"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <p class="hero-media-cap">
        <span class="live">{t.metaPlace}</span>
        <span>· <span data-bogota-clock>{formatBogotaTime()}</span></span>
      </p>
    </div>
  </div>
</header>
