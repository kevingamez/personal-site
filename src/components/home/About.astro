---
import type { HomeStrings } from "@/content/home"

interface Props {
  t: HomeStrings["about"]
  // Game of Life strings live under hero.* historically; the canvas moved here
  // when the Vela hero took the portrait.
  tGol: HomeStrings["hero"]
}

const { t, tGol } = Astro.props
---

<section id="about">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="sec-num">{t.secNum}</div>
        <h2 class="sec-title"><Fragment set:html={t.titleHtml} /></h2>
      </div>
      <p class="sec-blurb">{t.blurb}</p>
    </div>
    <div class="about-grid">
      <div class="gol-wrap">
        <div class="gol-frame">
          <canvas id="gol" role="img" aria-label={tGol.golAriaLabel}></canvas>
          <div class="gol-controls">
            <button
              class="gol-btn"
              id="gol-pause"
              title={tGol.pauseTitle}
              aria-label={tGol.pauseTitle}
              aria-pressed="false">⏸</button
            >
            <button class="gol-btn" id="gol-reset" title={tGol.resetTitle} aria-label={tGol.resetTitle}>↻</button>
          </div>
          <div class="gol-stamps">
            <button class="gol-stamp on" data-stamp="glider" aria-pressed="true">{tGol.stampGlider}</button>
            <button class="gol-stamp" data-stamp="lwss" aria-pressed="false">{tGol.stampLwss}</button>
            <button class="gol-stamp" data-stamp="pulsar" aria-pressed="false">{tGol.stampPulsar}</button>
            <button class="gol-stamp" data-stamp="gun" aria-pressed="false">{tGol.stampGun}</button>
            <button class="gol-stamp" data-stamp="clear">{tGol.stampClear}</button>
          </div>
        </div>
        <div class="gol-readout">
          <span>{tGol.gen} <b id="gol-gen">0</b></span>
          <span>{tGol.alive} <b id="gol-alive">0</b></span>
          <span>{tGol.fps} <b id="gol-fps">0</b></span>
        </div>
        <p class="gol-note"><Fragment set:html={tGol.golCaptionHtml} /></p>
      </div>
      <div class="about-prose">
        <p><Fragment set:html={t.p1Html} /></p>
        <p><Fragment set:html={t.p2Html} /></p>
        <p><Fragment set:html={t.p3Html} /></p>
        <div class="quick-facts">
          <div class="qf"><div class="k">{t.qfBased}</div><div class="v">{t.qfBasedV}</div></div>
          <div class="qf">
            <div class="k">{t.qfRole}</div><div class="v">{t.qfRoleV}</div>
          </div>
          <div class="qf">
            <div class="k">{t.qfStack}</div><div class="v">{t.qfStackV}</div>
          </div>
          <div class="qf">
            <div class="k">{t.qfObsessed}</div>
            <div class="v"><Fragment set:html={t.qfObsessedV} /></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
