---
import Layout from "@/components/Layout.astro"
import Nav from "@/components/home/Nav.astro"
import IntroCurtain from "@/components/home/IntroCurtain.astro"
import Hero from "@/components/home/Hero.astro"
import About from "@/components/home/About.astro"
import Stack from "@/components/home/Stack.astro"
import Experience from "@/components/home/Experience.astro"
import Work from "@/components/home/Work.astro"
import Deck from "@/components/home/Deck.astro"
import Github from "@/components/home/Github.astro"
import Strava from "@/components/home/Strava.astro"
import Writing from "@/components/home/Writing.astro"
import Console from "@/components/home/Console.astro"
import Contact from "@/components/home/Contact.astro"
import Footer from "@/components/home/Footer.astro"
import { es } from "@/content/home-es"
import { loadHomeStats } from "@/data/home-github"
import "@/styles/home/index.css"

const buildId = "a7f3c91"
const t = es
const githubStats = await loadHomeStats()
---

<Layout meta={t.meta}>
  <a class="skip" href="#main">{t.meta.skip}</a>

  <IntroCurtain name="Kevin Gámez" />
  <Nav meta={t.meta} t={t.nav} />
  <main id="main" tabindex="-1">
    <Hero t={t.hero} />
    <About t={t.about} tGol={t.hero} />
    <Stack t={t.stack} />
    <Experience t={t.experience} />
    <Work t={t.work} />
    <Deck t={t.deck} />
    <Github t={t.github} stats={githubStats} />
    <div class="strava-lazy-anchor" data-strava-lazy-anchor aria-hidden="true"></div>
    <Strava t={t.strava} />
    <Writing t={t.writing} />
    <Console t={t.console} />
    <Contact t={t.contact} />
  </main>
  <Footer t={t.footer} buildId={buildId} />

  <script>
    import "@/scripts/home/index.ts"
  </script>
</Layout>
